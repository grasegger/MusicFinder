{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "MusicFinder": {
        "Providers": [
            {
                "Name": "Rebuy",
                "UrlTemplate": "https://www.rebuy.de/kaufen/suchen?q={artist} {album}&c=83"
            },
            {
                "Name": "Medimops",
                "UrlTemplate": "https://www.medimops.de/musik-C0255882/?searchparam={artist} {album}&fcIsSearch=1"
            },
            {
                "Name": "Discogs",
                "UrlTemplate": "https://www.discogs.com/de/sell/list?q={artist} {album}&format=CD&ships_from=Germany"
            },
            {
                "Name": "Qobuz",
                "UrlTemplate": "https://www.qobuz.com/de-de/search/albums/{artist} {album}"
            },
            {
                "Name": "Bandcamp",
                "UrlTemplate": "https://bandcamp.com/search?q={artist} {album}&item_type=a"
            },
            {
                "Name": "Booklooker",
                "UrlTemplate": "https://www.booklooker.de/Musik/Angebote/artist={artist}&titel={album}"
            }
        ]
    }
}